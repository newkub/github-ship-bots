# Cloudflare bindings (D1, KV, R2) are defined in wrangler.toml
# D1: ship-feed-db
# KV: cdbd999cc26c4ca2a48f9d2dec865104
# R2: ship-feed-evidence, ship-feed-baselines

# WorkOS (required for auth)
WORKOS_CLIENT_ID=client_01M19F99TQW7CRED4Q65YAE0DH
WORKOS_REDIRECT_URI=https://github-ship-bots.newkubise.workers.dev/auth/callback
WORKOS_API_KEY=sk_test_...
WORKOS_COOKIE_PASSWORD=generate-a-32-char-random-string

# Stripe (required for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_TEAM=price_...

# GitHub App (required for bot/orchestrator)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Web push (required for mobile push notifications)
VAPID_PUBLIC_KEY=BM...
VAPID_PRIVATE_KEY=MHc...
VAPID_SUBJECT=mailto:admin@newkubise.workers.dev

# Internal bot token (used by github-ship-bots worker to post evidence)
BOT_TOKEN=generate-a-secure-random-token

# Optional: GitHub Actions / cron
CRON_SECRET=generate-a-secure-random-token

# Optional: OpenAI for AI features
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: override GitHub endpoints (defaults to public GitHub)
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com

# Optional notifications
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: auto-approve thresholds
AUTO_APPROVE_THRESHOLD=8.5
AUTO_APPROVE_RISK=low
