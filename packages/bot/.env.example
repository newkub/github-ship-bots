# GitHub App
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Optional webhook proxy for local dev
WEBHOOK_PROXY_URL=

# API connection (used to post cards to ship-feed)
API_URL=https://github-ship-bots.newkubise.workers.dev
BOT_TOKEN=

# OpenAI (required for AI code review)
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REVIEW_MODE=auto

# Optional: override GitHub endpoints (defaults to public GitHub)
GITHUB_API_URL=https://api.github.com
GITHUB_WEB_URL=https://github.com
