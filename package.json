{
  "name": "ship-feed",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:bot": "bun --filter @ship-feed/bot dev",
    "dev:api": "bun --filter @ship-feed/api dev",
    "dev:mobile": "bun --filter @ship-feed/mobile dev",
    "dev:web": "bun --filter @ship-feed/web dev",
    "dev:landing": "bun --filter @ship-feed/landing dev",
    "build:landing": "bun --filter @ship-feed/landing build",
    "build:web": "bun --filter @ship-feed/web build",
    "build:mobile": "bun --filter @ship-feed/mobile build",
    "build": "bun --filter @ship-feed/landing build && bun --filter @ship-feed/web build && bun --filter @ship-feed/mobile build",
    "lint": "bun --filter '*' lint",
    "test": "bun --filter '*' test",
    "deploy:bot": "bun --filter @ship-feed/bot deploy",
    "deploy:api": "bun --filter @ship-feed/api deploy"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.7.2"
  }
}
